# Application
APP_NAME=ProofChain RCA
APP_ENV=development

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# LangGraph extraction
GROQ_EXTRACTION_CHUNK_CHARS=12000
GROQ_EXTRACTION_OVERLAP_CHARS=500

# RCA reasoning context
RCA_MAX_CONTEXT_CHARS=60000
RCA_MAX_EVIDENCE_ITEMS=200

# Document storage
STORAGE_DIR=var/uploads

# Document processing
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=5000000
